# Google Gemini API
GOOGLE_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=768
GEMINI_GENERATION_MODEL=gemini-3.8-flash

# Qdrant Cloud or local Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ai_data_science_book

# Retrieval settings (tune the threshold with the evaluation set)
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.55
RAG_MAX_QUESTION_LENGTH=2000

# Markdown-aware chunking (approximate word counts)
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=80
RAG_EMBEDDING_BATCH_SIZE=16

# Frontend origins, comma-separated
ALLOWED_ORIGINS=http://localhost:3000

# Optional. Defaults to ../my-website/docs when running from backend/.
# BOOK_DOCS_PATH=C:/absolute/path/to/my-website/docs

